craft calculatePercentage(obtained: Decimal, total: Decimal) gives Decimal {
    yield (obtained * 100.0) / total;
}

craft checkPassing(marks: Whole) gives Truth {
    yield marks atleast 50;
}

launch main() gives Nothing {
    form studentName: Text := "Emaan";
    form rollNumber: Whole := 101;
    form obtainedMarks: Whole := 425;
    form totalMarks: Whole := 500;

    form percentage: Decimal := calculatePercentage(425.0, 500.0);
    form passed: Truth := checkPassing(obtainedMarks);

    display("Student Record");
    display(studentName);
    display(rollNumber);
    display(obtainedMarks);
    display(totalMarks);
    display(percentage);

    when (passed is yes) {
        display("Pass");
    } otherwise {
        display("Fail");
    }
}